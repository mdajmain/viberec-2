# Copy to .env and fill in. Never commit .env.
TMDB_API_KEY=            # themoviedb.org API key (plots, keywords, posters)
VIBEREC_API_KEY=         # shared secret between the web app's server and the API (any long random string)
# AWS credentials are not kept here: use an AWS CLI profile (e.g. `aws configure --profile viberec`) or an instance role.
